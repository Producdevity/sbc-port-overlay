@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/spoTargets.cmake")
set(spo_sdl2_FOUND FALSE)
if("sdl2" IN_LIST spo_FIND_COMPONENTS AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/spoSdlTargets.cmake")
  find_dependency(PkgConfig)
  pkg_check_modules(SDL2 REQUIRED IMPORTED_TARGET "sdl2>=2.0.6")
  include("${CMAKE_CURRENT_LIST_DIR}/spoSdlTargets.cmake")
  set(spo_sdl2_FOUND TRUE)
endif()
check_required_components(spo)
